# Copy to .env and fill in. .env is gitignored: never commit it or paste it anywhere.
# The server runs with NO .env at all against the example API; you only need this file for the
# test agent, evals and docs search, or when you point the server at your own API.

# --- Backend API -----------------------------------------------------------------------------
# API_BASE_URL=https://jsonplaceholder.typicode.com
# Optional bearer token, sent as "Authorization: Bearer <token>". Leave empty for public APIs.
API_TOKEN=
# HTTP_TIMEOUT_SECONDS=20

# --- AI provider keys (read by the providers from the environment) -----------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=          # for anthropic:* models (uv add langchain-anthropic)

# --- Test agent and evals --------------------------------------------------------------------
# provider:model strings for init_chat_model. Pin dated snapshots so eval scores stay comparable.
MODEL=openai:gpt-5.4-mini-2026-03-17
# JUDGE_MODEL=openai:gpt-5.4-mini-2026-03-17   # calibrate before changing: evals.calibrate_judge

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=example-mcp

# --- Docs search (search_docs) ---------------------------------------------------------------
# DOCS_SEARCH=true
# EMBEDDING_MODEL=openai:text-embedding-3-small   # must match between ingest and server
# DOCS_INDEX_DIR=data/chroma

# --- HTTP transport (only with `example-mcp --http`) -------------------------------------------
# Loopback only (127.0.0.1, localhost, ::1): the HTTP transport has no auth yet.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# --- Write tools (off by default) ------------------------------------------------------------
# WRITE_ALLOWED_IDS = comma-separated ids the server may change; empty = any id (logged as a warning).
ENABLE_WRITE_TOOLS=false
WRITE_ALLOWED_IDS=
